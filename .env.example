# ═══════════════════════════════════════════════════════════════════
# CoBuddy Companion Backend — Production Environment Template
# ═══════════════════════════════════════════════════════════════════

# ── 1. SERVER CONFIGURATION ───────────────────────────────────────
PORT=4001
NODE_ENV=production
# In production, set exact origins, comma-separated (e.g., https://companion.cobuddy.in,https://admin.cobuddy.in)
CORS_ORIGIN="https://companion.cobuddy.in"

# ── 2. DATABASE (PostgreSQL) ──────────────────────────────────────
# Production PostgreSQL connection string (Azure Flexible Server, AWS RDS, or Managed DB)
DATABASE_URL=

# ── 3. CACHE & QUEUES (Redis) ─────────────────────────────────────
# Production Redis connection string (Azure Cache for Redis or managed cluster)
REDIS_URL="redis://:REPLACE_WITH_REDIS_PASSWORD@redis.internal:6379/0"

# ── 4. AUTHENTICATION & TOKENS ───────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN="30d"
JWT_REFRESH_EXPIRES_IN="90d"

# ── 5. OTP CONFIGURATION ──────────────────────────────────────────
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
# QA/Testing without SMS provider:
# Test code 12345465 is ONLY accepted when OTP_TEST_BYPASS_ENABLED=true AND phone is listed in OTP_TEST_ALLOWED_PHONES.
OTP_TEST_BYPASS_ENABLED=false
OTP_TEST_ALLOWED_PHONES=

# No SMS sender is integrated in this backend yet. Ordinary OTP requests return 503.

# ── 6. PAYMENT GATEWAY (Razorpay) ─────────────────────────────────
# Used for session security deposits, direct payments, and companion payouts
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER="REPLACE_WITH_RAZORPAYX_ACCOUNT_NUMBER"

# ── 7. MEDIA STORAGE PROVIDER ─────────────────────────────────────
# Option A: Cloudinary (Recommended for image/video transformations)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option B: Amazon S3 / CloudFront
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="cobuddy-companion-uploads"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=""

# ── 8. PUSH NOTIFICATIONS (Firebase Admin SDK) ─────────────────────
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste the multi-line private key or escaped \n string from serviceAccountKey.json
FIREBASE_PRIVATE_KEY=

# ── 9. RATE LIMITING & SECURITY ───────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── 10. OBSERVABILITY & ERROR TRACKING ────────────────────────────
SENTRY_DSN=""

# ── 11. SERVICE-TO-SERVICE (S2S) INTERNAL COMMUNICATION ───────────
CUSTOMER_API_URL="http://localhost:4002"
ADMIN_API_URL=
# Set the same random value in the customer and companion backend environments.
INTERNAL_SERVICE_SECRET=
