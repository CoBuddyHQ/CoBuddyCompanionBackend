// CoBuddy Companion Backend — Complete Prisma Schema
// Maps exactly to store.types.ts interfaces in CoBuddyCompanion frontend
// Every model field aligns with the frontend data contracts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum ProfileStatus {
  draft
  submitted
  under_review
  approved
  published
  edit_rejected
}

enum VerificationStatus {
  not_started
  in_progress
  pending_review
  approved
  rejected
  resubmit_required
}

enum AccountStatus {
  active
  suspended
  deactivated
  deleted
}

enum TrustLevel {
  new
  building
  trusted
  highly_trusted
}

enum SessionStatus {
  upcoming
  pre_arrival
  checked_in
  active
  extending
  completed
  cancelled
  no_show
  disputed
}

enum RequestStatus {
  pending
  accepted
  declined
  expired
  counter_proposed
}

enum TransactionType {
  session_earning
  extension_earning
  safety_bonus
  platform_fee
  refund_deduction
  cancellation_penalty
  payout_transfer
}

enum TransactionStatus {
  pending_review
  approved
  payout_eligible
  paid
  deducted
  on_hold
}

enum PayoutStatus {
  idle
  requested
  processing
  completed
  failed
}

enum Category {
  cafe_conversation
  city_walk
  art_culture
  food_experience
  shopping_assistance
  events
  business_networking
  bookstore
  wellness_walk
  movies
}

enum TimerStatus {
  idle
  active
  expired
  cancelled
}

enum NotificationType {
  request
  session
  safety
  payout
  support
  policy
  training
  system
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPANION (core entity)
// Maps to CompanionProfile interface in store.types.ts
// ─────────────────────────────────────────────────────────────────────────────

model Companion {
  id                 String             @id @default(cuid())
  phone              String             @unique
  countryCode        String             @default("+91")
  email              String?            @unique
  dateOfBirth        DateTime?
  displayName        String?
  tagline            String?
  gender             String?
  city               String?
  willingToTravel    Boolean            @default(true)
  travelRadius       Int                @default(10)
  bio                String?            @db.Text
  interestTags       String[]           @default([])
  workPreferences    Json?
  commActivityPrefs  Json?
  venuePreferences   String[]           @default([])
  boundariesAccepted Boolean            @default(false)
  photoUrl           String?
  hourlyRate         Decimal?           @db.Decimal(10, 2)
  sessionDuration    Int                @default(90) // 60, 90, 120
  profileStatus      ProfileStatus      @default(draft)
  verificationStatus VerificationStatus @default(not_started)
  accountStatus      AccountStatus      @default(active)
  trustScore         Int                @default(0)
  trustLevel         TrustLevel         @default(new)
  rating             Decimal            @default(0.0) @db.Decimal(3, 1)
  totalReviews       Int                @default(0)
  totalSessions      Int                @default(0)
  responseRate       Int                @default(100)
  cancellationRate   Int                @default(0)
  isAvailable        Boolean            @default(false)
  isOnline           Boolean            @default(false)
  lastActiveAt       DateTime?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  serviceAreas      CompanionServiceArea[]
  categories        CompanionCategory[]
  languages         CompanionLanguage[]
  galleryPhotos     CompanionPhoto[]
  kyc               CompanionKYC?
  pin               CompanionPIN?
  biometrics        CompanionBiometric[]
  settings          CompanionSettings?
  refreshTokens     RefreshToken[]
  otpSessions       OTPSession[]
  sessions          Session[]
  bookingRequests   BookingRequest[]
  earningsTxns      EarningsTransaction[]
  payouts           PayoutRecord[]
  sosEvents         SOSEvent[]
  safetyTimer       SafetyTimer?
  trustedContacts   TrustedContact[]
  blockedCustomers  BlockedCustomer[]
  incidentReports   IncidentReport[]
  reviews           CompanionReview[]
  badges            CompanionBadge[]
  trustTasks        TrustTask[]
  notifications     Notification[]
  pushTokens        PushToken[]
  weeklySchedules   WeeklySchedule[]
  dateOverrides     DateOverride[]
  customSlots       CustomSlot[]
  vacationMode      VacationMode?
  moduleCompletions ModuleCompletion[]
  uploadedFiles     UploadedFile[]

  @@map("companions")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACCOUNT SETTINGS
// ─────────────────────────────────────────────────────────────────────────────

model CompanionSettings {
  id                 String  @id @default(cuid())
  companionId        String  @unique
  notificationPrefs  Json    @default("{}") // Store { new_booking_push: true, etc. }
  
  // Privacy Settings
  showAge            Boolean @default(true)
  allowPromo         Boolean @default(false)
  showInSearch       Boolean @default(true)
  
  language           String  @default("en")

  // Onboarding tracking & consents
  termsAccepted        Boolean @default(false)
  safetyRulesAccepted  Boolean @default(false)
  locationEnabled      Boolean @default(false)
  notificationsEnabled Boolean @default(false)

  // Safety Toggles
  locationTracking     Boolean @default(true)
  autoCheckIn          Boolean @default(true)
  disguisedCall        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("companion_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH MODELS
// ─────────────────────────────────────────────────────────────────────────────

model OTPSession {
  id        String   @id @default(cuid())
  phone     String
  otp       String // bcrypt hash
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  companion Companion? @relation(fields: [phone], references: [phone])

  @@map("otp_sessions")
}

model RefreshToken {
  id          String   @id @default(cuid())
  companionId String
  token       String   @unique
  deviceId    String?
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model CompanionPIN {
  id                String   @id @default(cuid())
  companionId       String   @unique
  pinHash           String
  biometricsEnabled Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("companion_pins")
}

model CompanionBiometric {
  id          String   @id @default(cuid())
  companionId String
  deviceId    String
  publicKey   String   @db.Text
  createdAt   DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([companionId, deviceId])
  @@map("companion_biometrics")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROFILE RELATED MODELS
// ─────────────────────────────────────────────────────────────────────────────

model CompanionServiceArea {
  id          String    @id @default(cuid())
  companionId String
  area        String
  city        String    @default("")
  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("companion_service_areas")
}

model CompanionCategory {
  id          String    @id @default(cuid())
  companionId String
  category    Category
  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([companionId, category])
  @@map("companion_categories")
}

model CompanionLanguage {
  id          String    @id @default(cuid())
  companionId String
  language    String
  proficiency String    @default("fluent")
  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([companionId, language])
  @@map("companion_languages")
}

model CompanionPhoto {
  id          String    @id @default(cuid())
  companionId String
  url         String
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("companion_photos")
}

// ─────────────────────────────────────────────────────────────────────────────
// KYC
// ─────────────────────────────────────────────────────────────────────────────

model CompanionKYC {
  id          String @id @default(cuid())
  companionId String @unique

  // Basic Info
  legalFirstName String?
  legalLastName  String?

  // Identity document
  identityDocumentType    String?
  identityDocumentUrl     String?
  identityDocumentBackUrl String?
  identitySubmittedAt     DateTime?

  // Selfie / liveness
  selfieImageUrl    String?
  selfieVideoUrl    String?
  selfieSubmittedAt DateTime?

  // Address
  addressLine1        String?
  addressLine2        String?
  addressCity         String?
  addressState        String?
  addressPinCode      String?
  addressType         String?
  addressIdMatch      Boolean @default(false)
  addressDocumentType String?
  addressDocumentUrl  String?
  addressSubmittedAt  DateTime?

  // Police verification
  policeVerificationUrl String?

  // PAN (privacy: masked only)
  maskedPan    String?
  panName      String?
  taxResidency String?
  hasGST       Boolean @default(false)
  gstNumber    String?

  // Bank account (privacy: last 4 digits only)
  bankHolderName    String?
  maskedBankAccount String? // e.g. "•••• 4821"
  bankIfsc          String?
  bankAccountType   String? // savings | current
  bankName          String?
  bankVerified      Boolean @default(false)

  // UPI (privacy: masked only)
  maskedUpi      String? // e.g. "ra••••@okaxis"
  upiPayoutLabel String?
  upiIsPrimary   Boolean @default(true)

  // Emergency contact (from KYC form)
  emergencyContactName         String?
  emergencyContactMaskedPhone  String?
  emergencyContactRelationship String?

  // Declaration
  declarationAgreedAt DateTime?
  declarationConsents Json?

  // Draft resume support
  draftStage String?
  draftData  String? @db.Text

  // Review lifecycle
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("companion_kyc")
}

// ─────────────────────────────────────────────────────────────────────────────
// BOOKING REQUESTS
// Maps to BookingRequest interface from store.types.ts
// ─────────────────────────────────────────────────────────────────────────────

model BookingRequest {
  id                       String        @id @default(cuid())
  companionId              String
  customerId               String
  status                   RequestStatus @default(pending)
  category                 Category
  // Customer info (denormalized for performance)
  customerInitials         String
  customerTrustScore       Int           @default(0)
  customerVerified         Boolean       @default(false)
  customerSessionCount     Int           @default(0)
  customerSafetyConsent    Boolean       @default(false)
  customerIdentityVerified Boolean       @default(false)
  // Venue info
  venueId                  String?
  venueName                String
  venueArea                String
  venueCity                String
  venueType                String        @default("PUBLIC")
  venueMeetingPoint        String?
  venueLandmark            String?
  isVenueApproved          Boolean       @default(true)
  // Timing
  proposedStart            DateTime
  proposedEnd              DateTime
  counterProposedStart     DateTime?
  counterProposedEnd       DateTime?
  durationMinutes          Int
  language                 String        @default("Hindi")
  estimatedEarning         Decimal       @default(0) @db.Decimal(10, 2)
  matchScore               Int           @default(0)
  customerNote             String?
  declineReason            String?
  expiresAt                DateTime
  receivedAt               DateTime      @default(now())
  respondedAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  session   Session?

  @@map("booking_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSIONS
// Maps to Session interface from store.types.ts
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id                       String        @id @default(cuid())
  companionId              String
  customerId               String
  requestId                String?       @unique
  status                   SessionStatus @default(upcoming)
  category                 Category
  // Customer snapshot
  customerInitials         String
  customerTrustScore       Int           @default(0)
  customerVerified         Boolean       @default(false)
  customerSessionCount     Int           @default(0)
  customerSafetyConsent    Boolean       @default(false)
  customerIdentityVerified Boolean       @default(false)
  // Venue snapshot
  venueId                  String?
  venueName                String
  venueArea                String
  venueCity                String
  venueType                String        @default("PUBLIC")
  venueMeetingPoint        String?
  venueLandmark            String?
  isVenueApproved          Boolean       @default(true)
  // Timing
  scheduledStart           DateTime
  scheduledEnd             DateTime
  durationMinutes          Int
  language                 String        @default("Hindi")
  // Earnings
  baseEarning              Decimal       @default(0) @db.Decimal(10, 2)
  bonusEarning             Decimal       @default(0) @db.Decimal(10, 2)
  estimatedTotal           Decimal       @default(0) @db.Decimal(10, 2)
  confirmedEarning         Decimal?      @db.Decimal(10, 2)
  // Session flow
  sessionPassCode          String?
  checkInTime              DateTime?
  checkOutTime             DateTime?
  completedAt              DateTime?
  cancelReason             String?
  cancelledBy              String?
  noShowAt                 DateTime?
  safetyTimerActive        Boolean       @default(false)
  notes                    String?       @db.Text
  customerRating           Int?
  customerFeedback         String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  companion    Companion             @relation(fields: [companionId], references: [id], onDelete: Cascade)
  request      BookingRequest?       @relation(fields: [requestId], references: [id])
  earningsTxns EarningsTransaction[]

  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// EARNINGS
// Maps to EarningsTransaction + PayoutRecord from store.types.ts
// ─────────────────────────────────────────────────────────────────────────────

model EarningsTransaction {
  id               String            @id @default(cuid())
  companionId      String
  sessionId        String?
  payoutId         String?
  type             TransactionType
  status           TransactionStatus
  amount           Decimal           @db.Decimal(10, 2)
  customerInitials String?
  description      String
  payoutEligibleAt DateTime?
  createdAt        DateTime          @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  session   Session?  @relation(fields: [sessionId], references: [id])

  @@map("earnings_transactions")
}

model PayoutRecord {
  id            String       @id @default(cuid())
  companionId   String
  status        PayoutStatus @default(requested)
  amount        Decimal      @db.Decimal(10, 2)
  platformFee   Decimal      @default(0) @db.Decimal(10, 2)
  maskedBank    String
  utrNumber     String?
  failureReason String?
  requestedAt   DateTime     @default(now())
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("payout_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// SAFETY
// ─────────────────────────────────────────────────────────────────────────────

model SOSEvent {
  id          String    @id @default(cuid())
  companionId String
  sessionId   String?
  latitude    Decimal?  @db.Decimal(10, 8)
  longitude   Decimal?  @db.Decimal(11, 8)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime  @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("sos_events")
}

model SafetyTimer {
  id              String      @id @default(cuid())
  companionId     String      @unique
  sessionId       String?
  status          TimerStatus @default(active)
  durationMinutes Int
  startedAt       DateTime    @default(now())
  expiresAt       DateTime
  lastCheckinAt   DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("safety_timers")
}

model TrustedContact {
  id                 String    @id @default(cuid())
  companionId        String
  name               String
  phone              String
  maskedPhone        String
  relationship       String
  isEmergencyContact Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("trusted_contacts")
}

model BlockedCustomer {
  id          String   @id @default(cuid())
  companionId String
  customerId  String
  reason      String?
  createdAt   DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([companionId, customerId])
  @@map("blocked_customers")
}

model IncidentReport {
  id           String   @id @default(cuid())
  companionId  String
  sessionId    String?
  description  String   @db.Text
  evidenceUrls String[] @default([])
  status       String   @default("submitted")
  createdAt    DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("incident_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEWS & TRUST
// Maps to CompanionReview interface from store.types.ts
// ─────────────────────────────────────────────────────────────────────────────

model CompanionReview {
  id               String   @id @default(cuid())
  companionId      String
  sessionId        String   @unique
  customerInitials String
  rating           Int // 1–5
  isPublic         Boolean  @default(true)
  highlights       String[] @default([])
  comment          String?
  sessionCategory  Category
  sessionDate      DateTime
  durationMinutes  Int      @default(60)
  replyText        String?  @db.Text
  isReported       Boolean  @default(false)
  createdAt        DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("companion_reviews")
}

model CompanionBadge {
  id          String   @id @default(cuid())
  companionId String
  badgeKey    String
  badgeName   String
  earnedAt    DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([companionId, badgeKey])
  @@map("companion_badges")
}

model TrustTask {
  id          String    @id @default(cuid())
  companionId String
  taskId      String
  title       String
  description String
  category    String
  points      Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("trust_tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String   @id @default(cuid())
  companionId String
  sessionId   String?
  subject     String
  description String   @db.Text
  category    String
  priority    String   @default("NORMAL")
  status      String   @default("OPEN") // "OPEN" | "CLOSED" | "UNDER REVIEW" | "RESOLVED"
  
  // Dispute specific fields
  customerName String?
  amount       String?
  outcome      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    TicketMessage[]
  timeline    DisputeTimelineEvent[]

  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  sender    String   @default("me") // "me" | "agent"
  text      String   @db.Text
  createdAt DateTime @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model DisputeTimelineEvent {
  id        String   @id @default(cuid())
  ticketId  String
  date      String
  desc      String
  createdAt DateTime @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("dispute_timeline_events")
}

model HelpArticle {
  id          String   @id
  title       String
  category    String
  body        String[]
  updatedDate String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("help_articles")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// Maps to Notification interface from store.types.ts
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  companionId String
  type        NotificationType
  title       String
  body        String
  isRead      Boolean          @default(false)
  readAt      DateTime?
  data        String? // JSON string for deep link data
  createdAt   DateTime         @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([companionId, isRead])
  @@map("notifications")
}

model PushToken {
  id          String   @id @default(cuid())
  companionId String
  token       String
  deviceId    String
  platform    String // ios | android
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([companionId, deviceId])
  @@map("push_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// AVAILABILITY
// ─────────────────────────────────────────────────────────────────────────────

model WeeklySchedule {
  id          String   @id @default(cuid())
  companionId String
  day         String
  active      Boolean  @default(true)
  times       String
  createdAt   DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@unique([companionId, day])
  @@map("weekly_schedules")
}

model DateOverride {
  id          String   @id @default(cuid())
  companionId String
  startDate   String
  endDate     String
  reason      String
  note        String?
  fullDay     Boolean  @default(true)
  startTime   String?
  endTime     String?
  createdAt   DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("date_overrides")
}

model CustomSlot {
  id          String   @id @default(cuid())
  companionId String
  date        String
  startTime   String
  endTime     String
  repeat      Boolean  @default(false)
  createdAt   DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("custom_slots")
}

model VacationMode {
  id          String    @id @default(cuid())
  companionId String    @unique
  enabled     Boolean   @default(false)
  awayFrom    String?
  returnOn    String?
  updatedAt   DateTime  @updatedAt

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("vacation_modes")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINING
// ─────────────────────────────────────────────────────────────────────────────

model TrainingModule {
  id              String   @id @default(cuid())
  title           String
  duration        String
  required        Boolean  @default(false)
  body            String[] @default([]) // Array of strings
  takeaways       String[] @default([]) // Array of strings
  createdAt       DateTime @default(now())

  completions ModuleCompletion[]

  @@map("training_modules")
}

model ModuleCompletion {
  id          String   @id @default(cuid())
  companionId String
  moduleId    String
  score       Int      @default(0)
  completedAt DateTime @default(now())

  companion Companion      @relation(fields: [companionId], references: [id], onDelete: Cascade)
  module    TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companionId, moduleId])
  @@map("module_completions")
}

// ─────────────────────────────────────────────────────────────────────────────
// UPLOADS
// ─────────────────────────────────────────────────────────────────────────────

model UploadedFile {
  id           String   @id @default(cuid())
  companionId  String
  url          String
  key          String   @unique
  category     String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("uploaded_files")
}
