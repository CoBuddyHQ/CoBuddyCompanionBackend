## ──────────────────────────────────────────────────────────
## CoBuddy Companion Backend — Environment Configuration
## Development (Zero-Cost Stack)
## ──────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────
PORT=4001
NODE_ENV=development

# ── Database (Docker PostgreSQL) ──────────────────────────
DATABASE_URL="postgresql://cobuddy:cobuddy_secret@localhost:5432/cobuddy_companion?schema=public"

# ── Cache (Docker Redis) ──────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:8081,http://10.0.2.2:8081,http://localhost:3000"

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET="cobuddy-companion-jwt-secret-dev-change-in-production"
JWT_REFRESH_SECRET="cobuddy-companion-refresh-secret-dev-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ── OTP ───────────────────────────────────────────────────
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Dev bypass OTP — always works in development mode
OTP_DEV_BYPASS=123456

# ── Rate Limiting ─────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── File Upload (Local Disk — Zero Cost Development) ──────
# Leave AWS keys empty → auto falls back to local /uploads folder
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="cobuddy-companion-uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
CLOUDFRONT_DOMAIN=""
# For production: fill above AWS keys → auto switches to S3

# ── Razorpay (Test Mode — Zero Cost) ─────────────────────
# Get test keys from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID="rzp_test_TLCpKIamWxQBYy"
RAZORPAY_KEY_SECRET="dIRFQTp0IT3YeVdV3N0V8acf"
RAZORPAY_WEBHOOK_SECRET="cobuddy_webhook_secret_dev"


RAZORPAY_ACCOUNT_NUMBER="QljVyfH2dbrsKE"

# For production: replace with rzp_live_* keys

# ── Firebase (FCM Push Notifications) ────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# For production: fill the above with your Firebase service account credentials

# ── SMS Provider (Production Only) ───────────────────────
# Leave blank during development — backend OTP used instead
SMS_PROVIDER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
# For production: SMS_PROVIDER="msg91"

# ── Cloudinary (Image Uploads) ───────────────────────────
CLOUDINARY_CLOUD_NAME="dzosfpdot"
CLOUDINARY_API_KEY="155891872428514"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"
